 图 2：通用执行流程（三层控制流）
═══════════════════════════════════════════════════════════════════════

flowchart TD
    START([🚀 程序启动]) --> IMPORT[导入依赖<br/>configparser · json · openai<br/>+ 平台/系统库]

    IMPORT --> READ_CFG["📖 读取 config.ini<br/>config.read('config.ini')"]

    READ_CFG --> BUILD_CLIENT["🔧 构建 OpenAI Client<br/>base_url=config['llm']['base_url']<br/>api_key=config['llm']['api_key']<br/>model=config['llm']['model']"]

    BUILD_CLIENT --> DEF_TOOLS["📐 定义 Tool Schemas<br/>tools = [{type:'function', function:{...}}, ...]"]

    DEF_TOOLS --> BUILD_MAP["🗺️ 构建 tool_map<br/>tool_map = {'name': func, ...}"]

    BUILD_MAP --> INIT_MSG["📝 初始化消息列表<br/>messages = []"]

    INIT_MSG --> L1{"🔁 第一层循环<br/>while True<br/>（用户会话循环）"}

    L1 --> USER_INPUT["⌨️ 等待用户输入<br/>user_input = input('你: ')"]
    USER_INPUT --> ADD_USER["📥 messages.append<br/>{'role':'user',<br/> 'content': user_input}"]

    ADD_USER --> L2{"🔁 第二层循环<br/>while True<br/>（工具调用链循环）"}

    L2 --> STREAM_CALL["🌊 流式 LLM 调用<br/>client.chat.completions.create(<br/>  model=model,<br/>  messages=messages,<br/>  tools=tools,<br/>  stream=True<br/>)"]

    STREAM_CALL --> CHUNK_LOOP{"📦 遍历 chunk<br/>(第三层: 流消费循环)"}

    CHUNK_LOOP --> PARSE_DELTA["解析 delta = chunk.choices[0].delta"]

    PARSE_DELTA --> CHECK_TYPE{"delta 内容类型?"}

    CHECK_TYPE -->|"delta.content"| PRINT_TEXT["🖨️ 实时打印文本<br/>print(content, end='')"]
    PRINT_TEXT --> ACCUM_TEXT["content += delta.content"]

    CHECK_TYPE -->|"delta.tool_calls"| MERGE_TC["🔀 合并 tool_calls<br/>tool_calls.setdefault(index)<br/>聚合 id · name · arguments"]

    ACCUM_TEXT --> NEXT_CHUNK{"还有更多 chunk?"}
    MERGE_TC --> NEXT_CHUNK

    NEXT_CHUNK -->|"✅ 是"| CHUNK_LOOP
    NEXT_CHUNK -->|"❌ 否<br/>流结束"| HAS_TC{"tool_calls<br/>非空?"}

    HAS_TC -->|"❌ 否<br/>纯文本回复"| ADD_ASSIST["📤 messages.append<br/>{'role':'assistant',<br/> 'content': content}"]
    ADD_ASSIST --> L1

    HAS_TC -->|"✅ 是<br/>需要调用工具"| BUILD_TCS["🔨 构建 assistant_tool_calls<br/>[{id, type:'function',<br/>  function:{name, arguments}}, ...]"]

    BUILD_TCS --> ADD_ASSIST_TC["📤 messages.append<br/>{'role':'assistant',<br/> 'content': content or None,<br/> 'tool_calls': assistant_tool_calls}"]

    ADD_ASSIST_TC --> DISPATCH_LOOP{"🔁 遍历每个 tool_call"}

    DISPATCH_LOOP --> PARSE_ARGS["📋 json.loads<br/>解析 arguments JSON"]

    PARSE_ARGS --> DISPATCH["🎯 tool_map[name](**args)<br/>按函数名分发执行"]

    DISPATCH --> EXEC_TOOL["⚡ 执行工具函数<br/>返回 output 字符串"]

    EXEC_TOOL --> PRINT_RESULT["🖨️ 打印执行结果<br/>[tool] name → output"]

    PRINT_RESULT --> ADD_TOOL_MSG["📤 messages.append<br/>{'role':'tool',<br/> 'tool_call_id': tc['id'],<br/> 'content': str(output)}"]

    ADD_TOOL_MSG --> MORE_TC{"还有更多<br/>tool_call?"}
    MORE_TC -->|"✅ 是"| DISPATCH_LOOP
    MORE_TC -->|"❌ 否"| L2

