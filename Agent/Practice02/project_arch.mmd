 图 4：Tool Schema → tool_map 映射关系
═══════════════════════════════════════════════════════════════════════

flowchart LR
    subgraph LLM_SIDE["🧠 LLM 侧"]
        DECISION["模型决定调用哪个函数"]
        OUTPUT_JSON["输出 function.name<br/>+ function.arguments (JSON)"]
    end

    subgraph CLIENT_SIDE["💻 客户端侧"]
        SCHEMA["tools = [<br/>  {type:'function',<br/>   function: {<br/>     name: '...',<br/>     description: '...',<br/>     parameters: {...}<br/>   }<br/>  }, ...<br/>]"]
        MAP["tool_map = {<br/>  'getcwd': getcwd,<br/>  'listdir': listdir,<br/>  'getFileType': getFileType,<br/>  'readFile': readFile,<br/>  'createFile': createFile,<br/>  'writeFile': writeFile,<br/>  'mkdir': mkdir,<br/>  'rmdir': rmdir,<br/>  'rmFile': rmFile,<br/>  'rename': rename,<br/>  'getDate': getDate,<br/>  'isLeapYear': isLeapYear<br/>}"]
        INVOKE["tool_map[name](**args)"]
    end

    DECISION -->|"匹配"| SCHEMA
    OUTPUT_JSON -->|"解析"| INVOKE
    SCHEMA -.->|"定义"| MAP
    MAP --> INVOKE

